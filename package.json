{
  "name": "spectral",
  "version": "0.1.1",
  "private": true,
  "description": "Browser extension that surfaces the infrastructure behind the site you are visiting",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.ts --watch",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "firefox:lint": "web-ext lint --source-dir dist-firefox",
    "firefox:run": "web-ext run --source-dir dist-firefox",
    "firefox:android": "web-ext run --source-dir dist-firefox --target firefox-android",
    "test:e2e": "playwright test",
    "icons": "node scripts/render-icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
