{
  "manifest_version": 3,
  "name": "Spectral",
  "version": "0.1.0",
  "description": "See the infrastructure behind the site you are visiting: CDN, hosting, network owner, DNS and email providers.",
  "action": {
    "default_title": "Spectral",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spectral@danielededo.it",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
